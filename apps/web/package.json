{
  "name": "holdmysession",
  "version": "0.9.2",
  "description": "Local observability dashboard for Claude Code sessions",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/holdmysocks/HoldMySession",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holdmysocks/HoldMySession.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "dashboard",
    "session",
    "observability",
    "ai",
    "anthropic"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "holdmysession": "bin/cli.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node ./bin/cli.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "lint": "eslint src/",
    "prepack": "cp ../../README.md ./README.md",
    "prepublishOnly": "npm run build",
    "themes": "node --experimental-strip-types scripts/generate-themes-css.mts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.2",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "date-fns": "^4.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.7.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "picomatch": "^4.0.0",
    "minimatch": "^11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.2.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "happy-dom": "^21.0.4",
    "jsdom": "^29.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  }
}
